# Ключ с https://proxyapi.ru/ (не ключ platform.openai.com)
OPENAI_API_KEY=

# Единый OpenAI-совместимый адрес ProxyAPI
OPENAI_BASE_URL=https://api.proxyapi.ru/v1

# Модель, доступная в кабинете ProxyAPI
OPENAI_MODEL=gpt-4o-mini

RATE_LIMIT_PER_MINUTE=10
SQLITE_PATH=data/tickets.db
SEED_DEMO=true
LLM_TIMEOUT_SECONDS=30
